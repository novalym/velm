# =============================================================================
# == GNOSTIC SHARD: security/omni-citadel
# =============================================================================
# @id: security/omni-citadel
# @version: 3.5.0-Ω
# @tier: soul
# @summary: The ultimate security monolith providing JWT, RBAC, and Secret Masking.
# @author: SCAF-GenesisEngine-Prime
# @vibe: [citadel, warded, encrypted, autonomic, high-status]
# -----------------------------------------------------------------------------
# @metabolism:
#   python: [python-jose, passlib, bcrypt, python-multipart]
#   node: [jsonwebtoken, lucide-react, cookie]
# -----------------------------------------------------------------------------
# @substrate: {"agnostic": true}
# -----------------------------------------------------------------------------
# @suture:
#   role: security-spine
#   priority: 100
#   alias: citadel
# -----------------------------------------------------------------------------
# @ocular-ui:
#   - toggle(key="harden_passwords", label="Enforce Argon2 ID", default=true)
#   - toggle(key="rotate_keys", label="Autonomic Key Rotation", default=true)
#   - input(key="token_expiry", label="JWT TTL (Minutes)", default="60")
# -----------------------------------------------------------------------------
# @provides: [capability:identity-warden, capability:secret-vault]
# @requires: [capability:api-heart, capability:persistence]
# =============================================================================

# --- MOVEMENT I: ARCHITECTURAL SIGNALS (THE PULSE) ---
@signal security_level = "{{ 'PARANOID' if harden_passwords else 'STANDARD' }}"
@signal active_secret = "{{ env('JWT_SECRET') | default('@secret(base64, 64)') }}"

# =============================================================================
# == THE CITADEL COMPONENT DEFINITION                                        ==
# =============================================================================
@component SecurityCitadel(algorithm: str = "HS256", use_cookies: bool = true):
    """
    LIF: ∞ | ROLE: IDENTITY_AND_ACCESS_ORCHESTRATOR
    Materializes the entire security vertical across the Iron and the Eye.
    """

    # 1. QUANTUM ENTANGLEMENT
    # Siphons the database connection from the multiverse for user storage.
    @entangle DatabaseConnection as db

    # 2. TELEPATHIC PROVISION
    # Proclaims to all other components that the Warden is waked.
    @provide IdentityWarden = {
        "engine": "Citadel",
        "auth_url": "/api/v1/auth/login",
        "algorithm": algorithm,
        "is_hardened": harden_passwords
    }

    # 3. THE AKASHIC HOIST
    # Tells the main API router to include our security routes.
    @hoist routes = {
        "name": "Auth",
        "prefix": "/auth",
        "module": "core.security.router",
        "handler": "AuthRouter"
    }

    # --- MOVEMENT II: THE MIND (PYTHON BACKEND) ---
    src/{{ package_name }}/core/security/warden.py :: """
    import time
    from jose import jwt
    from passlib.context import CryptContext

    # [GNOSTIC SUTURE]: Level {{ security_level }}
    SECRET_KEY = "{{ active_secret }}"
    ALGORITHM = "{{ algorithm }}"
    
    pwd_context = CryptContext(schemes=["bcrypt"], deprecated="auto")

    def create_access_token(data: dict):
        to_encode = data.copy()
        expire = time.time() + (int("{{ token_expiry }}") * 60)
        to_encode.update({"exp": expire})
        return jwt.encode(to_encode, SECRET_KEY, algorithm=ALGORITHM)
    """

    # --- MOVEMENT III: HOLOGRAPHIC MORPHOGENESIS ---
    # [THE MASTER CURE]: We surgically inject ourselves into the main.py
    # using the AST Lens. No Regex, no brittle text matching.
    @morph "src/{{ package_name }}/main.py" target "Call[func.attr='include_router']":
        @inject_before:
            from .core.security.warden import CitadelMiddleware
            app.add_middleware(CitadelMiddleware, secret="{{ active_secret }}")

    # --- MOVEMENT IV: THE EYE (TYPESCRIPT SECRETS) ---
    @if use_cookies:
        src/ui/lib/auth_vault.ts :: """
        // [AUTONOMIC VAULT]: Generated via Omni-Citadel
        export const storeToken = (token: string) => {
            document.cookie = `session=${token}; Secure; HttpOnly; SameSite=Strict`;
        };
        """

    # --- MOVEMENT V: OMNIPRESENT INTERCEPTION ---
    # Ensure every Auth-related file is warded against linter noise
    @intercept "**/security/*.py" += "# ruff: noqa: E402"

    # --- MOVEMENT VI: KINETIC LIFECYCLE ---
    @on_mount:
        proclaim: "🛡️ [CITADEL] Identity Warden waked. Mode: {{ security_level }}."
        # Generate the initial master key if willed
        @if rotate_keys:
            >> velm tool hash generate-secret --len 64 as MASTER_KEY
            proclaim: "Initial entropy waked and warded."

# =============================================================================
# == THE MOUNTING RITE (EXAMPLE)                                             ==
# =============================================================================
# mount SecurityCitadel(algorithm="RS256")